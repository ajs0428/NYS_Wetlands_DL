writeRaster(tw_rast_sub, filename = fn_labels, overwrite = TRUE)
} else {
message("Already file ", fn_labels)
}
},
error = function(e) {
message("Error: ", conditionMessage(e))
return(NA)
})
}
return(NULL)
}
