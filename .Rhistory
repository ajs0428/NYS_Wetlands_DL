set.seed(11)
args <- c(
"Data/Training_Data/R_Patches_Vector_Reviewed/", #Path to GIS reviewed wetland vector patches
128, # patch size 1/2
208 # cluster subset options include number or NULL for any
)
message("these are the arguments: \n",
