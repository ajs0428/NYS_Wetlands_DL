!Models/results_arch_v3/*/*/seed*/metrics.json
!Models/results_arch_fusion_v3/*/*/seed*/metrics.json
!Models/factorial_results_v3/*/*/seed*/manifest.json
!Models/results_arch_v3/*/*/seed*/manifest.json
!Models/results_arch_fusion_v3/*/*/seed*/manifest.json
!Models/factorial_results_v3/*/*/seed*/confusion_matrix.csv
!Models/results_arch_v3/*/*/seed*/confusion_matrix.csv
!Models/results_arch_fusion_v3/*/*/seed*/confusion_matrix.csv
!Models/factorial_results_v3/*/*/seed*/training_log.json
!Models/results_arch_v3/*/*/seed*/training_log.json
!Models/results_arch_fusion_v3/*/*/seed*/training_log.json
!Models/factorial_results_v3/*/*/seed*/training_history_*.json
!Models/results_arch_v3/*/*/seed*/training_history_*.json
!Models/results_arch_fusion_v3/*/*/seed*/training_history_*.json
!Models/factorial_results_v3/*/*/seed*/shap/
!Models/factorial_results_v3/*/*/seed*/shap/*_shap_importance.json
!Models/results_arch_fusion_v3/*/*/seed*/gates/
