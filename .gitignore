!Models/results_arch_fusion_v3/*/*/seed*/gates/*.npz
# --- production model (Models/production_model/<mode>/production/seed<k>/) ----
# Same <mode> nesting as the v2 roots. The manifest is whitelisted here (it is
# not in the factorial roots) because provenance -- git_commit, pool rule, band
# list -- is what makes a SHIPPED checkpoint auditable after the fact.
!Models/production_model/
!Models/production_model/analysis/
!Models/production_model/analysis/**
!Models/production_model/*/
!Models/production_model/*/*/
!Models/production_model/*/*/seed*/
!Models/production_model/*/*/seed*/metrics.json
!Models/production_model/*/*/seed*/manifest.json
!Models/production_model/*/*/seed*/confusion_matrix.csv
!Models/production_model/*/*/seed*/training_log.json
!Models/production_model/*/*/seed*/training_history_*.json
# re-ignore heavy artifacts + generated outputs the globs above would catch:
Models/**/.ipynb_checkpoints/
Models/**/figures/
Models/**/*.png
Models/**/*.ckpt
Models/**/*.safetensors
