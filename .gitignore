# Ignore everything
*

# Except these directories
!Python_Code_Analysis/
!Data/
!Data/Training_Data/
!Data/Training_Data/R_Patches/
!Documentation/
!R_Code_Analysis/
!Shell_Scripts/

# Don't ignore files directly in these directories
!Python_Code_Analysis/*
!R_Code_Analysis/*
!Shell_Scripts/*.sh
# But do ignore these
Python_Code_Analysis/raster_footprint*

# Ignore directories in directories (probably quarto stuff)
# except the DL stuff now
!Python_Code_Analysis/DL_Learning/*.ipynb
!Python_Code_Analysis/DL_Learning/*.py
!Python_Code_Analysis/DL_Implement/*.py
!Python_Code_Analysis/DL_Implement/*.ipynb
!Python_Code_Analysis/torchgeo_testing/*.ipynb
!Python_Code_Analysis/torchgeo_testing/*.py
!Python_Code_Analysis/DL_Pipeline_v2/*
!Python_Code_Analysis/DL_Pipeline_v2/factorial_experiment/
!Python_Code_Analysis/DL_Pipeline_v2/factorial_experiment/*
# but not generated HTML previews
Python_Code_Analysis/DL_Pipeline_v2/factorial_experiment/*.html
# production model workstream (docs + recipe); same shape as factorial_experiment
!Python_Code_Analysis/DL_Pipeline_v2/production_model/
!Python_Code_Analysis/DL_Pipeline_v2/production_model/*
!Python_Code_Analysis/DL_Pipeline_v2/arch_fusion/
!Python_Code_Analysis/DL_Pipeline_v2/arch_fusion/*
Python_Code_Analysis/DL_Pipeline_v2/production_model/*.html
Python_Code_Analysis/DL_Pipeline_v2/production_model/__pycache__/

# Track models directory structure but not contents
!Models/
Models/*
!Models/.gitkeep


!.gitignore
!.gitattributes
!.dockerignore
!Dockerfile
!pyproject.toml
CLAUDE.md
!AGENTS.md
!*.Rproj
!*.RHistory
!README.md
!prediction_041402011002_viz.png
.*Rproj.user
.Rproj.user
!.gitkeep
!Data/Training_Data/
!Data/

# --- webmap viewer source (root rule is `*`, so this needs whitelisting) ------
# The Leaflet/COG viewer + its dev server. Source only -- the COGs and any
# generated tiles it serves are data and stay ignored.
!webmap/
!webmap/*.py
!webmap/*.md
!webmap/viewer/
!webmap/viewer/*.html
!webmap/viewer/*.js
!webmap/viewer/*.css
webmap/__pycache__/

# --- generated R outputs (rendered artifacts, not source) --------------------
R_Code_Analysis/*.html
R_Code_Analysis/Rplots.pdf
R_Code_Analysis/.positron-temp-*

# --- dl_10 lightweight notebook inputs (sync small CSV/JSON via git) ----------
# §1–§7 of dl_10_factorial_viz.ipynb read these; the heavy .ckpt/.safetensors
# and the HUC GeoTIFFs (used by dl_10b_huc_inference_viz.ipynb) stay ignored.
# Re-add (git add) after each aggregation run. Reaching deep files requires
# un-ignoring every parent dir first (root rule is `*`).
# analysis/ CSVs for all three results roots:
!Models/factorial_results/
!Models/factorial_results/analysis/
!Models/factorial_results/analysis/**
!Models/results_patchcurve/
!Models/results_patchcurve/analysis/
!Models/results_patchcurve/analysis/**
!Models/results_arch/
!Models/results_arch/analysis/
!Models/results_arch/analysis/**
# per-seed metrics + SHAP JSON (read directly by §4/§6/§7):
!Models/factorial_results/*/
!Models/factorial_results/*/seed*/
!Models/factorial_results/*/seed*/metrics.json
!Models/factorial_results/*/seed*/training_log.json
!Models/factorial_results/*/seed*/training_history_*.json
!Models/factorial_results/*/seed*/shap/
!Models/factorial_results/*/seed*/shap/*_shap_importance.json
!Models/results_patchcurve/*/
!Models/results_patchcurve/*/seed*/
!Models/results_patchcurve/*/seed*/metrics.json
!Models/results_patchcurve/*/seed*/training_log.json
!Models/results_arch/*/
!Models/results_arch/*/seed*/
!Models/results_arch/*/seed*/metrics.json
!Models/results_arch/*/seed*/training_log.json
!Models/results_arch/*/seed*/training_history_*.json
# --- v2 results roots (read by R_Code_Analysis/dl_10_Factorial_viz_R.qmd) ----
